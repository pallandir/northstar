# These are process environment variables read by the MCP server and its hooks.
# No code loads a .env file, so set them in the env block of your agent's MCP
# server entry or export them in the shell that starts the agent.

# First port the MCP ingest server tries. It then tries 7474, 7475 and 7476.
# NORTHSTAR_PORT=7474

# Absolute path of the project root where .northstar/ comments are stored.
# Defaults to the current working directory when the server starts.
# NORTHSTAR_ROOT=/path/to/your/project

# Force a terminal driver instead of detecting one: tmux, iterm, terminal-app or none.
# NORTHSTAR_TERMINAL=tmux

# Set to 0 to stop Send to AI from typing into your terminal.
# NORTHSTAR_INJECT=1

# Tool packs to enable at start: dynamic, all, or a comma list such as research,system.
# NORTHSTAR_PACKS=dynamic

# Set to off to open the DESIGN.md gate for UI edits. Only for a user who asked to skip it.
# NORTHSTAR_GATE=off
