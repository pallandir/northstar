{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["tests/*.test.ts", "tests/*.spec.ts", "scripts/*.mjs"],
      "project": ["tests/**/*.ts", "scripts/*.mjs"],
      "ignoreDependencies": ["@modelcontextprotocol/sdk"]
    },
    "mcp": {
      "entry": ["scripts/**/*.{ts,mjs}"],
      "project": ["src/**/*.ts", "scripts/**/*.{ts,mjs}"]
    },
    "canon": {
      "entry": [],
      "project": ["src/**/*.ts"]
    },
    "protocol": {
      "entry": [],
      "project": ["src/**/*.ts"]
    },
    "extensions/core": {
      "entry": [
        "src/background.ts",
        "src/content/content.ts",
        "src/options/options.ts",
        "manifest.base.ts"
      ],
      "project": ["src/**/*.ts"]
    },
    "extensions/chromium": {
      "entry": ["manifest.config.ts"],
      "project": ["*.ts"]
    },
    "extensions/firefox": {
      "entry": ["manifest.config.ts", "web-ext-config.mjs"],
      "project": ["*.ts", "*.mjs"]
    }
  }
}
