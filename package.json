{
  "name": "northstar",
  "version": "2.5.0",
  "private": true,
  "type": "module",
  "description": "A UI design advisory framework for AI coding agents, with a browser extension to leave comments on the running UI.",
  "license": "MIT",
  "workspaces": [
    "canon",
    "packages/*",
    "extensions/core",
    "extensions/chromium",
    "extensions/firefox",
    "mcp"
  ],
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "tmp": "^0.2.7"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:chromium": "npm run build --workspace @northstar/chromium",
    "build:firefox": "npm run build --workspace @northstar/firefox",
    "package:chromium": "npm run package --workspace @northstar/chromium",
    "package:firefox": "npm run package --workspace @northstar/firefox",
    "lint:amo": "npm run lint:amo --workspace @northstar/firefox",
    "dev": "node scripts/dev.mjs",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome check .",
    "format": "biome format --write .",
    "prepare": "husky",
    "gen": "npm run gen --workspace @northstar/adapters",
    "gen:check": "npm run gen:check --workspace @northstar/adapters",
    "check:pack": "node scripts/check-pack-size.mjs",
    "check:versions": "node scripts/check-versions.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "typescript": "~5.9.3"
  }
}
