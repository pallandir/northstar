{
  "name": "northstar",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Leave real-time comments on any interface and let your local AI coding assistant act on them.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "workspaces": ["extension/core", "extension/chromium", "extension/firefox", "mcp"],
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "tmp": "^0.2.7"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:chromium": "npm run build --workspace @northstar/chromium",
    "build:firefox": "npm run build --workspace @northstar/firefox",
    "package:chromium": "npm run package --workspace @northstar/chromium",
    "package:firefox": "npm run package --workspace @northstar/firefox",
    "lint:amo": "npm run lint:amo --workspace @northstar/firefox",
    "dev": "npm run dev --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome check .",
    "format": "biome format --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "typescript": "~5.9.3"
  }
}
