{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "northstar": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@pallandir/northstar@2.3.0"
      ],
      "enabled": true,
      "environment": {
        "NORTHSTAR_PACKS": "all"
      },
      "timeout": 30000
    }
  }
}
