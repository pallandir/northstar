{
  "name": "@pallandir/northstar",
  "version": "2.5.0",
  "description": "UI design advisory framework for AI coding agents: MCP server, design canon, static detector and installer, plus the Northstar browser comment handoff.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/pallandir/northstar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pallandir/northstar.git",
    "directory": "mcp"
  },
  "bugs": {
    "url": "https://github.com/pallandir/northstar/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-coding-assistant",
    "ui-design",
    "design-system",
    "design-review",
    "anti-slop",
    "ui-feedback",
    "agent-skills"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "northstar": "dist/cli.js"
  },
  "files": ["dist", "LICENSE.md", "NOTICE", "THIRD_PARTY_LICENSES.md", "README.md"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "prepack": "node -e \"for (const f of ['LICENSE.md','NOTICE','THIRD_PARTY_LICENSES.md']) require('fs').copyFileSync('../'+f,f)\"",
    "prepublishOnly": "npm run build",
    "gen": "tsx scripts/gen/cli.ts",
    "gen:check": "tsx scripts/gen/cli.ts --check",
    "port": "tsx scripts/port-uupm.ts"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xterm/headless": "^6.0.0",
    "yaml": "^2.8.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@northstar/canon": "*",
    "@northstar/protocol": "*",
    "tsup": "^8.3.5"
  }
}
